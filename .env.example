# Optional historical CVD and modelled liquidation heatmaps.
# CVD requires a compatible CoinGlass plan; heatmaps require Professional or higher.
COINGLASS_API_KEY=
# The data service always binds to the local loopback interface.
PORT=8787

# Optional Bybit execution (Unified Trading Account).
# Keep keys local. Use an API key with read/trade permissions, without withdrawals.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_NETWORK=testnet
BYBIT_TRADING_ENABLED=false
# Mainnet additionally requires this explicit opt-in.
BYBIT_ALLOW_MAINNET=false
MAX_ORDER_NOTIONAL_USDT=1000
